# Скопируйте в .env и заполните

BASE_URL=https://pretenzii.mebel-arigato.ru
COMPANY_NAME=Мебель Аригато
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Первый вход (создаётся один раз, если сотрудников ещё нет)
ADMIN_NAME=Родион
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Почта для писем клиентам и сотрудникам (пример — Яндекс 360: smtp.yandex.ru, порт 465, пароль приложения)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=pretenzii@mebel-arigato.ru
SMTP_PASSWORD=
SMTP_FROM=Мебель Аригато <pretenzii@mebel-arigato.ru>

# Telegram-бот (создать у @BotFather). Без токена напоминания идут на email
TELEGRAM_BOT_TOKEN=
# Имя бота без @, например arigato_pretenzii_bot
TELEGRAM_BOT_NAME=

# Правила (менять при необходимости)
REVIEW_DAYS=2
MAX_REPAIR_DAYS=30
ROP_COMPENSATION_LIMIT=10000
REMIND_HOUR=9
IGNORE_CHECK_HOUR=18
# Праздничные нерабочие дни, переносят окончание срока: 2026-12-31,2027-01-01,...
HOLIDAYS=
